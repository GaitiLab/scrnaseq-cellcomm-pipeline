/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {
    conda      = "${CONDA_PREFIX}/envs/cci"
    container  = "joank23/scrnaseqcellcomm"

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
    ]

    // PREP_DATA
    withName: 'UTILS_EXTRACT_METADATA|UTILS_CREATE_SAMPLESHEET' {
        publishDir = [
            path: { "${params.outdir}/01_prepare_data/01_misc" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt") || filename.endsWith("_reduced_size.rds") || filename.endsWith("_reduced_size_subset.rds")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: 'SEURAT_REDUCE_OBJECT_SIZE|SEURAT_SUBSET_OBJECT|SEURAT_EXTRACT_SAMPLE' {
        publishDir = [
            path: { "${params.outdir}/01_prepare_data/02_intermediate_objects" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt") || filename.endsWith("_reduced_size.rds") || filename.endsWith("_reduced_size_subset.rds")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: 'SEURAT_PREPROCESS_SAMPLE|SEURAT_CONVERT_SEURAT_TO_MTX' {
        publishDir = [
            path: { "${params.outdir}/01_prepare_data/03_preprocessed_objects" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    // ---- RUN_CCI ---- //




    withName: CELL2CELL_RUN {
        conda      = "${CONDA_PREFIX}/envs/cell2cell"
        container  = "joank23/cell2cell"
        maxRetries = 5
        publishDir = [
            path: { "${params.outdir}/02_run_cci/01_cell2cell/01_raw" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }


    withName: CELL2CELL_FORMAT {
        publishDir = [
            path: { "${params.outdir}/02_run_cci/01_cell2cell/02_formatted" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: CELLCHAT_RUN {
        cpus       = 1
        publishDir = [
            path: { "${params.outdir}/02_run_cci/02_cellchat/01_raw" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: CELLCHAT_FORMAT {
        publishDir = [
            path: { "${params.outdir}/02_run_cci/02_cellchat/02_formatted" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }
    withName: CPDB_RUN {
        cpus       = 16
        conda      = "${CONDA_PREFIX}/envs/cpdb"
        container  = "joank23/cpdb"
        maxRetries = 5
        publishDir = [
            path: { "${params.outdir}/02_run_cci/03_cellphonedb/01_raw" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }


    withName: CPDB_FORMAT {
        publishDir = [
            path: { "${params.outdir}/02_run_cci/03_cellphonedb/02_formatted" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: LIANA_RUN {
        maxRetries = 12
        publishDir = [
            path: { "${params.outdir}/02_run_cci/04_liana/01_raw" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: LIANA_FORMAT {
        publishDir = [
            path: { "${params.outdir}/02_run_cci/04_liana/02_formatted" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    // ---- CONSENSUS ---- //

    withName: 'RRA|TAKE_CONSENSUS_ACROSS_TOOLS' {
        publishDir = [
            path: { "${params.outdir}/03_consensus/intermediate_objects" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    withName: COMBINE_SAMPLES {
        publishDir = [
            path: { "${params.outdir}/03_consensus" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }

    // ---- AGGREGATION ---- //
    withName: 'FILTER_BY_DETECTION_IN_MULTI_SAMPLES|AGGREGATE_SAMPLES|FILTER_AGGREGATED_RESULTS|UTILS_SAVE_AS_XLSX' {
        publishDir = [
            path: { "${params.outdir}/04_aggregation" },
            mode: "copy",
            saveAs: { filename ->
                if (filename.equals('versions.yml') || filename.equals("ok.txt")) {
                    null
                }
                else {
                    filename
                }
            },
        ]
    }
}
